# Copy this file to .env and fill in your values
# psycopg3 dialect — note the "+psycopg" in the scheme
DATABASE_URL=postgresql+psycopg://restaurantops:password@localhost:5432/restaurantops

# Separate test DB so tests never touch production data
TEST_DATABASE_URL=postgresql+psycopg://restaurantops:password@localhost:5432/restaurantops_test

CORS_ORIGINS=http://localhost:3000

# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# development | staging | production
ENVIRONMENT=development

# Rate limiting (requests per IP per time window)
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_WRITE=20/minute

# Email notifications (optional). Leave SMTP_HOST empty to send in-app only.
# EMAIL_BACKEND=console logs emails instead of sending them (useful in dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=RestaurantOps <no-reply@example.com>
# Public frontend URL, used for links in emails
APP_URL=

# WhatsApp notifications via WuzAPI (optional, Todo-Pilot §4). Leave WUZAPI_URL
# empty to skip WhatsApp. WHATSAPP_BACKEND=console logs messages instead (dev).
# Users opt in themselves under Settings → WhatsApp.
WUZAPI_URL=
WUZAPI_TOKEN=
WHATSAPP_MAX_PER_HOUR=20
WHATSAPP_DEDUP_MINUTES=10
