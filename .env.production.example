# ─────────────────────────────────────────────────────────────────────────────
# RestaurantOps backend — PRODUCTION environment
# Copy to .env.production on the VPS and fill every value. Never commit it.
#   cp .env.production.example .env.production
# ─────────────────────────────────────────────────────────────────────────────

# --- Postgres (used by the `db` service AND to build DATABASE_URL) ------------
# IMPORTANT: use URL-safe characters only (letters + digits). Characters like
# @ : / # ? % break the assembled DATABASE_URL. Generate a safe one:
#   openssl rand -hex 24      (or)   python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_USER=restaurantops
POSTGRES_PASSWORD=CHANGE_ME_hex_only_no_symbols
POSTGRES_DB=restaurantops

# DATABASE_URL is assembled from the POSTGRES_* vars in docker-compose.yml and
# points at the `db` service. You normally do NOT need to set it here.
# DATABASE_URL=postgresql+psycopg://restaurantops:password@db:5432/restaurantops

# --- Security ---------------------------------------------------------------
# App refuses to boot in production without this. Generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_64_hex_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

ENVIRONMENT=production

# --- CORS -------------------------------------------------------------------
# Comma-separated, no trailing slash. Add every frontend origin that will call
# this API (your Vercel/Netlify production domain + any preview domains).
CORS_ORIGINS=https://your-frontend.vercel.app

# --- Rate limiting ---------------------------------------------------------------
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_WRITE=20/minute

# --- File uploads (work-order photos) --------------------------------------------
STORAGE_BACKEND=local
STORAGE_DIR=/data/uploads
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_MIME=image/jpeg,image/png,image/webp

# --- Gunicorn (optional overrides) ---------------------------------------------
# WEB_CONCURRENCY=3
# LOG_LEVEL=info

# --- First boot only ---------------------------------------------------------
# Set to 1 for the very first `up` to seed master data + the first admin user,
# then set back to 0 and `docker compose up -d` again.
RUN_SEED=0

# --- Caddy TLS proxy (only if you use `--profile proxy`) ----------------------
# DOMAIN=api.yourdomain.com
# ACME_EMAIL=you@yourdomain.com
